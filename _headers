# Cloudflare Workers static-asset headers

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The sitemap's browser stylesheet. X-Content-Type-Options: nosniff below
# means Chrome refuses to apply it unless the type is declared exactly.
/sitemap.xsl
  Content-Type: text/xsl; charset=utf-8
  Cache-Control: public, max-age=3600

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# robots.txt keeps crawlers out of these, so Google never reads their meta
# noindex; a link from anywhere could still get the bare URL listed. The
# header travels with the response, so it holds even where crawling stops.
/admin
  X-Robots-Tag: noindex, nofollow
/admin.html
  X-Robots-Tag: noindex, nofollow
/manage
  X-Robots-Tag: noindex, nofollow
/manage.html
  X-Robots-Tag: noindex, nofollow

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
